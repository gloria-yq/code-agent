# Copy to .env in the target workspace or export these variables in your shell.
# .env is ignored by Git. Never commit or record the real credential.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

